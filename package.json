    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "bcryptjs": "3.0.3",
    "next": "16.4.3",
    "nodemailer": "10.2.1",
    "openai": "7.43.0",
    "pg": "^8.16.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "stripe": "23.0.1",
