# ============================================================
# MARKETPILOT - FILL THIS FILE IN
# ============================================================
# Copy this file to .env.local for local development.
# In Netlify, add the same variables under Environment variables.
#
# Anything starting with REPLACE_ME_ must be replaced.
# Values already filled below are safe, non-secret defaults.
# Keep X empty if you want the MVP to stay zero-cost.
# ============================================================

# ----------------------------
# 1. APP
# ----------------------------
NEXT_PUBLIC_APP_URL=REPLACE_ME_YOUR_DEPLOYED_APP_URL
MARKETPILOT_DEMO_MODE=false
NEXT_PUBLIC_LEGAL_ENTITY_NAME=REPLACE_ME_YOUR_LEGAL_ENTITY_NAME
NEXT_PUBLIC_LEGAL_CONTACT_EMAIL=REPLACE_ME_YOUR_SUPPORT_OR_PRIVACY_EMAIL

# ----------------------------
# 2. DATABASE - SUPABASE
# ----------------------------
# Supabase Dashboard -> Connect
# DATABASE_URL = Transaction pooler, normally port 6543
# DIRECT_URL   = Session pooler, normally port 5432
DATABASE_URL=REPLACE_ME_SUPABASE_TRANSACTION_POOLER_URL
DIRECT_URL=REPLACE_ME_SUPABASE_SESSION_POOLER_URL
DATABASE_SCHEMA=marketpilot

# ----------------------------
# 3. APP SECRETS
# ----------------------------
# Generate THREE different values with:
# openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=REPLACE_ME_RANDOM_SECRET_1
CRON_SECRET=REPLACE_ME_RANDOM_SECRET_2
UNSUBSCRIBE_SECRET=REPLACE_ME_RANDOM_SECRET_3

# ----------------------------
# 4. FREE TEXT AI - GOOGLE GEMINI
# ----------------------------
# Google AI Studio -> Create API key
GEMINI_API_KEY=REPLACE_ME_GEMINI_API_KEY
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# ----------------------------
# 5. FREE IMAGE AI - CLOUDFLARE WORKERS AI
# ----------------------------
# Cloudflare -> Workers AI / API Tokens
CLOUDFLARE_ACCOUNT_ID=REPLACE_ME_CLOUDFLARE_ACCOUNT_ID
CLOUDFLARE_AI_API_TOKEN=REPLACE_ME_CLOUDFLARE_WORKERS_AI_TOKEN
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell

# ----------------------------
# 6. MEDIA STORAGE - SUPABASE STORAGE
# ----------------------------
# These non-secret values are already configured for your Supabase project.
S3_REGION=eu-central-1
S3_ENDPOINT=https://ldwuqulwpecgjfhqpbbw.storage.supabase.co/storage/v1/s3
S3_BUCKET=marketpilot-media
S3_PUBLIC_BASE_URL=https://ldwuqulwpecgjfhqpbbw.supabase.co/storage/v1/object/public/marketpilot-media

# Supabase Dashboard -> Storage -> S3 Configuration -> Access keys
S3_ACCESS_KEY_ID=REPLACE_ME_SUPABASE_S3_ACCESS_KEY_ID
S3_SECRET_ACCESS_KEY=REPLACE_ME_SUPABASE_S3_SECRET_ACCESS_KEY

# ----------------------------
# 7. EMAIL - BREVO SMTP
# ----------------------------
# Leave these commented until you create the Brevo account.
# Then remove the # and replace each REPLACE_ME value.
# SMTP_HOST=REPLACE_ME_BREVO_SMTP_HOST
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=REPLACE_ME_BREVO_SMTP_USER
# SMTP_PASSWORD=REPLACE_ME_BREVO_SMTP_PASSWORD
# SMTP_FROM=REPLACE_ME_VERIFIED_FROM_EMAIL

# ----------------------------
# 8. STRIPE - BILLING
# ----------------------------
# Leave commented until Stripe Test Mode is configured.
# STRIPE_SECRET_KEY=REPLACE_ME_STRIPE_SECRET_KEY
# STRIPE_WEBHOOK_SECRET=REPLACE_ME_STRIPE_WEBHOOK_SECRET
# STRIPE_PRICE_STARTER=REPLACE_ME_STRIPE_STARTER_PRICE_ID
# STRIPE_PRICE_GROWTH=REPLACE_ME_STRIPE_GROWTH_PRICE_ID
# STRIPE_PRICE_PRO=
# STRIPE_PRICE_AGENCY=
# STRIPE_PRICE_CREDITS_100=REPLACE_ME_STRIPE_100_CREDITS_PRICE_ID
# STRIPE_PRICE_CREDITS_300=REPLACE_ME_STRIPE_300_CREDITS_PRICE_ID
# STRIPE_PRICE_CREDITS_1000=REPLACE_ME_STRIPE_1000_CREDITS_PRICE_ID

# ----------------------------
# 9. INSTAGRAM / META
# ----------------------------
# Leave commented until the Meta developer app is created.
# META_APP_ID=REPLACE_ME_META_APP_ID
# META_APP_SECRET=REPLACE_ME_META_APP_SECRET
META_GRAPH_VERSION=v25.0
META_SCOPES=instagram_business_basic,instagram_business_content_publish

# ----------------------------
# 10. TIKTOK
# ----------------------------
# Leave commented until the TikTok developer app is created.
# TIKTOK_CLIENT_KEY=REPLACE_ME_TIKTOK_CLIENT_KEY
# TIKTOK_CLIENT_SECRET=REPLACE_ME_TIKTOK_CLIENT_SECRET
TIKTOK_SCOPES=user.info.basic,video.publish,video.upload,video.list

# ----------------------------
# 11. X / TWITTER
# ----------------------------
# Intentionally disabled for the zero-cost MVP.
# X API posting is paid. Leave these commented unless you decide to enable it.
# X_CLIENT_ID=REPLACE_ME_X_CLIENT_ID
# X_CLIENT_SECRET=REPLACE_ME_X_CLIENT_SECRET
X_SCOPES=tweet.read tweet.write users.read offline.access
