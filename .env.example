# ============================================================
# MARKETPILOT - LOCAL DEVELOPMENT
# ============================================================
# Copy this file to .env.local, or run:
#   npm run setup:local
#
# The setup script preserves any Gemini/Cloudflare keys you already added,
# configures local PostgreSQL + local media, and generates missing app secrets.
# Anything starting with REPLACE_ME_ still needs your value.
# ============================================================

# ----------------------------
# 1. LOCAL APP
# ----------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
MARKETPILOT_DEMO_MODE=false
NEXT_PUBLIC_LEGAL_ENTITY_NAME=REPLACE_ME_YOUR_LEGAL_ENTITY_NAME
NEXT_PUBLIC_LEGAL_CONTACT_EMAIL=REPLACE_ME_YOUR_SUPPORT_OR_PRIVACY_EMAIL

# ----------------------------
# 2. LOCAL POSTGRESQL
# ----------------------------
# Created automatically by compose.yaml / npm run db:local:setup
DATABASE_URL=postgresql://marketpilot:marketpilot@127.0.0.1:5432/marketpilot
DIRECT_URL=postgresql://marketpilot:marketpilot@127.0.0.1:5432/marketpilot
DATABASE_SCHEMA=public
DATABASE_POOL_MAX=10

# ----------------------------
# 3. LOCAL MEDIA STORAGE
# ----------------------------
# No Supabase/S3 required while developing locally.
MEDIA_STORAGE=local
LOCAL_MEDIA_DIR=public/uploads

# ----------------------------
# 4. APP SECRETS
# ----------------------------
# npm run setup:local generates these automatically when missing.
TOKEN_ENCRYPTION_KEY=REPLACE_ME_RANDOM_SECRET_1
CRON_SECRET=REPLACE_ME_RANDOM_SECRET_2
UNSUBSCRIBE_SECRET=REPLACE_ME_RANDOM_SECRET_3

# ----------------------------
# 5. FREE TEXT AI - GOOGLE GEMINI
# ----------------------------
GEMINI_API_KEY=REPLACE_ME_GEMINI_API_KEY
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# ----------------------------
# 6. FREE IMAGE AI - CLOUDFLARE WORKERS AI
# ----------------------------
CLOUDFLARE_ACCOUNT_ID=REPLACE_ME_CLOUDFLARE_ACCOUNT_ID
CLOUDFLARE_AI_API_TOKEN=REPLACE_ME_CLOUDFLARE_WORKERS_AI_TOKEN
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell

# ----------------------------
# 7. OPTIONAL FUTURE S3 STORAGE
# ----------------------------
# Only enable this when you deploy and want persistent cloud media.
# Set MEDIA_STORAGE=s3 and then configure:
# S3_REGION=
# S3_ENDPOINT=
# S3_BUCKET=
# S3_PUBLIC_BASE_URL=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# ----------------------------
# 8. EMAIL - OPTIONAL FOR NOW
# ----------------------------
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=

# ----------------------------
# 9. STRIPE - OPTIONAL FOR NOW
# ----------------------------
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_STARTER=
# STRIPE_PRICE_GROWTH=
# STRIPE_PRICE_PRO=
# STRIPE_PRICE_AGENCY=
# STRIPE_PRICE_CREDITS_100=
# STRIPE_PRICE_CREDITS_300=
# STRIPE_PRICE_CREDITS_1000=

# ----------------------------
# 10. INSTAGRAM / META - OPTIONAL FOR NOW
# ----------------------------
# META_APP_ID=
# META_APP_SECRET=
META_GRAPH_VERSION=v25.0
META_SCOPES=instagram_business_basic,instagram_business_content_publish

# ----------------------------
# 11. TIKTOK - OPTIONAL FOR NOW
# ----------------------------
# TIKTOK_CLIENT_KEY=
# TIKTOK_CLIENT_SECRET=
TIKTOK_SCOPES=user.info.basic,video.publish,video.upload,video.list

# ----------------------------
# 12. X - LEAVE DISABLED FOR ZERO-COST MVP
# ----------------------------
# X_CLIENT_ID=
# X_CLIENT_SECRET=
X_SCOPES=tweet.read tweet.write users.read offline.access
